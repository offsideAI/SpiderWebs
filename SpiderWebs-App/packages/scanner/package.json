{
  "name": "@spiderwebs/scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SpiderWebs deterministic scan pipeline: ingest → parse → OSV vulnerability lookup",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@spiderwebs/core": "workspace:*",
    "@spiderwebs/schema": "workspace:*",
    "p-limit": "7.3.0",
    "p-retry": "8.0.0",
    "simple-git": "3.36.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
